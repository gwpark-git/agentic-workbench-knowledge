units lj
dimension 3
boundary p p p
atom_style atomic
read_data inputs/A100_phi0.30_halfdt_rep0.data
pair_style soft 1.0
pair_coeff * * 100 1.0
neighbor 0.3 bin
neigh_modify every 1 delay 0 check yes
timestep 1e-05
fix bd all brownian 1.0 984021 gamma_t 1.0 rng gaussian
compute pv all pressure NULL pair
compute displacement all msd
variable osm equal 0.5729577951308231+c_pv
variable ep equal pe/atoms
fix samples all ave/time 1000 1 1000 c_pv v_osm v_ep c_displacement[4] file outputs/A100_phi0.30_halfdt_rep0.dat
thermo_style custom step c_pv v_osm pe c_displacement[4]
thermo_modify norm no
thermo 100000
run 500000
write_dump all custom outputs/A100_phi0.30_halfdt_rep0_equilibrated.dump id type x y z modify sort id
run 2000000
write_dump all custom outputs/A100_phi0.30_halfdt_rep0_final.dump id type x y z modify sort id
write_restart outputs/A100_phi0.30_halfdt_rep0.restart
